# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"

# Application runtime environment
PORT="3000"
NODE_ENV="development"
LOG_LEVEL="info"

# PostgreSQL Configuration
POSTGRES_USER="jobhunt"
POSTGRES_PASSWORD="change_me_to_a_secure_password"
POSTGRES_DB="jobhunt_os"
POSTGRES_PORT="5432"

# PostgreSQL Database Connection
DATABASE_URL="postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:5432/${POSTGRES_DB}"

# Redis Queue & Cache Connection
REDIS_PORT="6379"
# Redis now requires authentication inside Docker (generate with: openssl rand -base64 24)
REDIS_PASSWORD="change_me_to_a_secure_redis_password"
REDIS_URL="redis://:${REDIS_PASSWORD}@localhost:6379/0"

# Authentication & Security (generate with: openssl rand -base64 32)
JWT_SECRET="change_me_to_a_secure_jwt_secret_min_32_chars"

# Optional notification channels
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
